# GameNight SPA build-time configuration.
#
# Vite reads .env files from this directory (assets/) at dev/build time.
# Copy this file to `assets/.env.local` for local overrides, or set the
# variables in the deploy environment for production builds.
#
# Documented for feature 006-landing-page (specs/006-landing-page/).

# Canonical site origin used to construct absolute URLs (Open Graph
# image, Twitter Card image). No trailing slash.
#
# Dev fallback: http://localhost:4000
# Production:   set in deploy config to the canonical site origin
#               (e.g. https://gamenight.example.com).
VITE_SITE_ORIGIN=http://localhost:4000

# Public contact address surfaced in the marketing footer and inside
# the /privacy and /terms stub pages. Public, not a secret.
#
# Dev fallback: hello@example.com
# Production:   set in deploy config to the real contact mailbox.
VITE_CONTACT_EMAIL=hello@example.com

# Single social/community link surfaced in the marketing footer.
#
# Dev fallback: https://github.com/
# Production:   set in deploy config to the real project URL.
VITE_SOCIAL_URL=https://github.com/
