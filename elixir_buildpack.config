# Pinned to match .tool-versions so the buildpack-built artifact
# matches what we develop and test against locally.
erlang_version=28.4.2
elixir_version=1.19.5

# Don't try to be clever about skipping recompiles — Gigalixir's
# build cache already handles that, and this avoids stale compile
# artifacts when the priv/static manifest is regenerated.
always_rebuild=false
