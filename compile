#!/usr/bin/env bash
# Custom phoenix-static buildpack compile step.
#
# The buildpack sources this script from inside $assets_dir
# (= ./assets), with $phoenix_dir pointing at the project root.
# By the time we run, the elixir buildpack has already executed
# `mix deps.get`, `mix deps.compile`, and `mix compile` — so deps/
# is populated and `_build/prod/lib/game_night/priv/` has been
# materialised from the project's `priv/`. The buildpack has
# also already done a best-effort `npm install` here.
#
# `mix compile --force` regenerates the
# /tmp/phoenix-colocated-{used,unused}/game_night stubs that
# phoenix_live_view's compiler writes for `colocated_hook` (and
# friends). assets/js/app.js imports them via a vite plugin; if
# they're missing, `bun vite build` fails with
#   [vite:load-fallback] Could not load /tmp/phoenix-colocated-unused/game_night
# We don't know whether /tmp gets swept between buildpacks or
# whether mix's incremental cache skips the generation step the
# second time around — `--force` makes both questions moot.

set -euo pipefail

BUN_VERSION="1.3.12"

cd "$phoenix_dir"

echo "-----> Installing bun $BUN_VERSION"
export BUN_INSTALL="$HOME/.bun"
curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"
export PATH="$BUN_INSTALL/bin:$PATH"
bun --version

echo "-----> Replacing node_modules with bun install"
(
  cd assets
  rm -rf node_modules
  bun install --frozen-lockfile
)

echo "-----> Forcing mix compile to regenerate phoenix-colocated stubs"
mix compile --force

echo "-----> Building SPA bundle (bun vite build)"
bun --cwd=assets vite build
