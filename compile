#!/usr/bin/env bash
# Custom phoenix-static buildpack compile step.
#
# The buildpack sources this script from inside $assets_dir
# (= ./assets), with $phoenix_dir pointing at the project root.
# By the time we run, the elixir buildpack has already executed
# `mix deps.get`, `mix deps.compile`, and `mix compile` — so deps/
# is populated and `_build/prod/lib/game_night/priv/` has been
# materialised from the project's `priv/`. The buildpack has
# also already done a best-effort `npm install` here.
#
# Everything below delegates to Mix aliases on purpose. The
# `assets.build` alias resolves to `mix bun vite build`, and
# the `:bun` config in config/config.exs sets MIX_BUILD_PATH on
# the bun process — which is what assets/vite.config.ts reads to
# resolve the `phoenix-colocated/game_night` import to the real
# `_build/prod/phoenix-colocated/game_night/` directory written
# by phoenix_live_view's compiler. Calling `bun vite build`
# directly leaves MIX_BUILD_PATH unset and vite falls back to an
# empty `/tmp/phoenix-colocated-unused` placeholder, which is
# how we got here.

set -euo pipefail

BUN_VERSION="1.3.12"

cd "$phoenix_dir"

# Install bun ourselves rather than relying on `mix bun.install`. The
# phoenix-static buildpack already ran `npm install` against
# assets/package.json before this script, leaving node_modules
# resolved by npm — not bun.lock. We need to wipe and reinstall with
# bun --frozen-lockfile, otherwise the resolved tree drifts from
# bun.lock and we get version-mismatch crashes (e.g. a Zod 3 API
# call inside @tanstack/router-generator against a Zod 4 install).
# `mix bun assets install` (the :bun Mix task) skips
# --frozen-lockfile, so we call bun directly here.
echo "-----> Installing bun $BUN_VERSION"
export BUN_INSTALL="$HOME/.bun"
curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"
export PATH="$BUN_INSTALL/bin:$PATH"
bun --version

echo "-----> Reinstalling assets/node_modules with bun (frozen lockfile)"
(
  cd assets
  rm -rf node_modules
  bun install --frozen-lockfile
)

echo "-----> mix compile --force (refresh _build/prod/phoenix-colocated stubs)"
mix compile --force

# `mix assets.deploy` aliases to `mix bun vite build`. The :bun
# Mix task is what sets MIX_BUILD_PATH on the bun process — that's
# what assets/vite.config.ts reads to resolve the
# `phoenix-colocated/<app>` import, so we still need to go through
# Mix here even though we just installed deps with bun directly.
echo "-----> mix assets.deploy (runs bun vite build with MIX_BUILD_PATH set)"
mix assets.deploy
