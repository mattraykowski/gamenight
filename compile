#!/usr/bin/env bash
# Custom phoenix-static buildpack compile step.
#
# The buildpack sources this script from inside $assets_dir
# (= ./assets), with $phoenix_dir pointing at the project root.
# By the time we run, the elixir buildpack has already executed
# `mix deps.get`, `mix deps.compile`, and `mix compile` — so deps/
# is populated and `_build/prod/lib/game_night/priv/` has been
# materialised from the project's `priv/`. The buildpack has
# also already done a best-effort `npm install` here.
#
# Everything below delegates to Mix aliases on purpose. The
# `assets.build` alias resolves to `mix bun vite build`, and
# the `:bun` config in config/config.exs sets MIX_BUILD_PATH on
# the bun process — which is what assets/vite.config.ts reads to
# resolve the `phoenix-colocated/game_night` import to the real
# `_build/prod/phoenix-colocated/game_night/` directory written
# by phoenix_live_view's compiler. Calling `bun vite build`
# directly leaves MIX_BUILD_PATH unset and vite falls back to an
# empty `/tmp/phoenix-colocated-unused` placeholder, which is
# how we got here.

set -euo pipefail

cd "$phoenix_dir"

echo "-----> mix assets.setup (download :bun, install assets/node_modules)"
mix assets.setup

echo "-----> mix compile --force (refresh _build/prod/phoenix-colocated stubs)"
mix compile --force

echo "-----> mix assets.deploy (runs bun vite build with MIX_BUILD_PATH set)"
mix assets.deploy
