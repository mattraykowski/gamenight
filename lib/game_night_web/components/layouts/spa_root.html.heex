<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="GameNight">{assigns[:page_title]}</.live_title>
    <%= if PhoenixVite.Components.has_vite_watcher?(GameNightWeb.Endpoint) do %>
      <%!--
        @vitejs/plugin-react HMR preamble. Required when Vite isn't the
        page's origin — Phoenix serves this HTML, so the plugin's
        index.html transform never runs and React Refresh can't detect
        its own preamble without this manual injection.
      --%>
      <script type="module">
        <%= Phoenix.HTML.raw("""
        import RefreshRuntime from #{Jason.encode!(static_url(@conn, "/@react-refresh"))}
        RefreshRuntime.injectIntoGlobalHook(window)
        window.$RefreshReg$ = () => {}
        window.$RefreshSig$ = () => (type) => type
        window.__vite_plugin_react_preamble_installed__ = true
        """) %>
      </script>
    <% end %>
    <%!--
      `to_url` strips the `?vsn=d` cache-buster that
      PhoenixVite.Components.assets hard-codes onto the entry chunk's
      <script> tag. Vite already content-hashes the filename
      (`index-XXX.js`), so the query string is redundant — and
      actively harmful: relative `import` and `<link rel=modulepreload>`
      references inside the bundle resolve to the *unqueried* URL,
      so the browser fetches the same chunk twice and instantiates
      React twice, leaving the React Compiler runtime reading a null
      dispatcher (`Cannot read properties of null (reading 'useMemoCache')`).
    --%>
    <PhoenixVite.Components.assets
      names={["js/index.tsx"]}
      manifest={{:game_night, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(GameNightWeb.Endpoint)}
      to_url={fn path -> static_url(@conn, String.replace(path, "?vsn=d", "")) end}
    />
  </head>
  <body>
    {@inner_content}
  </body>
</html>
