<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="GameNight">{assigns[:page_title]}</.live_title>
    <%= if PhoenixVite.Components.has_vite_watcher?(GameNightWeb.Endpoint) do %>
      <%!--
        @vitejs/plugin-react HMR preamble. Required when Vite isn't the
        page's origin — Phoenix serves this HTML, so the plugin's
        index.html transform never runs and React Refresh can't detect
        its own preamble without this manual injection.
      --%>
      <script type="module">
        <%= Phoenix.HTML.raw("""
        import RefreshRuntime from #{Jason.encode!(static_url(@conn, "/@react-refresh"))}
        RefreshRuntime.injectIntoGlobalHook(window)
        window.$RefreshReg$ = () => {}
        window.$RefreshSig$ = () => (type) => type
        window.__vite_plugin_react_preamble_installed__ = true
        """) %>
      </script>
    <% end %>
    <PhoenixVite.Components.assets
      names={["js/index.tsx"]}
      manifest={{:game_night, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(GameNightWeb.Endpoint)}
      to_url={&static_url(@conn, &1)}
    />
  </head>
  <body>
    {@inner_content}
  </body>
</html>
