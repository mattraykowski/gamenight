# Match .tool-versions. The phoenix-static buildpack still does its
# own `npm install` against assets/package.json before our custom
# compile script runs — we let it, then overwrite node_modules with
# `bun install` inside `compile`.
node_version=24.14.1

phoenix_relative_path=.
phoenix_ex=phx
assets_path=assets

# Point at our custom `compile` script (./compile at the repo root).
# That script replaces the default `npm run deploy` + `mix phx.digest`
# pipeline, which doesn't fit a bun + phoenix_vite app.
compile=compile

clean_cache=false
node_modules_cache=false

# Keep node in the slug — the runtime doesn't need it, but stripping
# it out has a habit of breaking surprising things and the size win
# is small relative to the BEAM image.
remove_node=false
